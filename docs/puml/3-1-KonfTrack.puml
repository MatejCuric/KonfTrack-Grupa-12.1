' ==============================================================================
' 3-1-KonfTrack.puml
'
 'Svrha:    Prikazuje tko i s kojim ciljem koristi sustav KonfTrack (javni
'           posjetitelji, autori, recenzenti, predsjednici programskog odbora,
'           administratori) te koje vanjske sustave sustav koristi (ORCID,
'           Crossref, Google Calendar, e-pošta). Interna logika, pohrana
'           podataka i korisničko sučelje namjerno nisu obuhvaćeni.
' Autor:    Nea Trumbić, kolegij Programsko inženjerstvo
' AI:       Dijagram je izradio autor. AI je pomogao u reviziji i komentarima;
'           autor ih je pregledao i odgovara za konačni sadržaj.
' Zahtjevi: UC-01 do UC-32 (F-001 do F-029, vidi tablicu u 3-Obrasci-uporabe.md)
'
' Diagram level: System Requirements
' Diagram type:  Use Case Diagram
' Version:       1.3
' ==============================================================================

@startuml
title Sustav KonfTrack - slučajevi uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #212529
    BackgroundColor<<external system>> #FFF3CD
    BorderColor<<external system>> #856404
}

skinparam usecase {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

' ==============================================================================
' Primarni akteri
' ==============================================================================

actor User as "Korisnik aplikacije"
actor Visitor as "Javni posjetitelj"
actor Author as "Autor/koautor"
actor Reviewer as "Recenzent"
actor Administrator as "Administrator"
actor Chair as "Predsjednik programskog odbora"

' Nasljeđivanje: specijalizirani -> opći (u istom stupcu)
Author -right-|> User
Reviewer -right-|> User
Chair -right-|> User
Administrator -right-|> User
User -right-|> Visitor

' Samo za raspored: svi akteri u jednom stupcu lijevo
Visitor -[hidden]right- User
User -[hidden]right- Author
Author -[hidden]right- Reviewer
Reviewer -[hidden]right- Chair
Chair -[hidden]right- Administrator

' ==============================================================================
' Sekundarni akteri (vanjski sustavi)
' ==============================================================================

actor "e-pošta" as Mail <<external system>>
actor "ORCID" as ORCID <<external system>>
actor "Crossref" as Crossref <<external system>>
actor "Google Calendar" as Calendar <<external system>>

' Samo za raspored: vanjski sustavi u jednom stupcu desno
ORCID -[hidden]right- Crossref
Crossref -[hidden]down- Calendar
Calendar -[hidden]down- Mail
Crossref -[hidden]down- ORCID

' ==============================================================================
' Granica sustava
' ==============================================================================

rectangle "Sustav za upravljanje konferencijom" as ConferenceSystem {

    ' Javni pristup i korisnički račun
    (UC-01\nPregled javne stranice konferencije) as UC_PublicPage
    (UC-02\nRegistracija ili prijava) as UC_SignIn
    (UC-19\nUpravljanje osobnim rasporedom) as UC_Schedule
    (UC-22\nPregled zbornika sažetaka) as UC_Collection
    (UC-03\nUređivanje profila) as UC_Account 

    'Autor/koautor
    (UC-04\nPredaja i promjena rada) as UC_SubmitPaper
    (UC-05\nPovlačenje rada) as UC_Return
    (UC-06\nPredaja revizije) as UC_Revision
    (UC-23\nPredaja neanonimizirane konačne verzije) as UC_Final

    ' Recenziranje
    (UC-07\nOdgovor na poziv u programski odbor) as UC_Invitation
    (UC-08\nIskazivanje interesa za radove) as UC_Interest
    (UC-09\nRasprava s recenzentima) as UC_Discourse
    (UC-31\nPregled "Moje recenzije") as UC_AllReviews
    (UC-32\nPredaja ocjene) as UC_Grade

    ' Upravljanje konferencijom i recenzentima
    (UC-10\nDefiniranje konferencije) as UC_Setup 
    (UC-20\nPozivanje recenzenata) as UC_InviteReviewers
    (UC-11\nUređivanje raspodjele radova recenzentima) as UC_Assignment
    (UC-12\nOdluke o radovima) as UC_Decisions

    (UC-13\nSlaganje programa konferencije) as UC_Program
    (UC-21\nPregled "Moji radovi") as UC_PaperManagement
    (UC-24\nPregled "Statistika") as UC_Statistics
    (UC-25\nPregled "Odluke") as UC_Ideas
    (UC-15\nObavijest o odluci) as UC_Notify

    ' Administracija
    (UC-14\nOdobravanje konferencije) as UC_Approval
    (UC-27\nDeaktivacija korisničkog računa) as UC_UserManagement
    (UC-28\nUređivanje predložaka e-pošte) as UC_EmailManagement
    (UC-29\nPregled statistike korištenja) as UC_UserStatistic
    

    ' Dodatni 

    (UC-16\nProvjera PDF-a) as UC_AuthorName
    (UC-17\nProvjera sukoba interesa) as UC_CheckConflict
    (UC-18\nDodjela zamjenskog recenzenta) as UC_ReplacementReviewer
    (UC-26\nProvjera konflikata rasporeda) as UC_ConflictProgram
    (UC-30\nImenovanje predsjednika) as UC_NameChair

    UC_ConflictProgram-[hidden]down- UC_Assignment
    UC_AuthorName -[hidden]-UC_NameChair


'note bottom of UC_Grade
'  F-020: Sustav automatski šalje recenzentima
'  podsjetnike e-poštom 7 i 2 dana prije roka
'  recenzije i označava kasne recenzije.
'end note
 
}

'  ==============================================================================
' Asocijacije aktera i slučajeva uporabe
' ==============================================================================

' Javni posjetitelj
Visitor -- UC_PublicPage
Visitor -- UC_SignIn
User -- UC_Collection


'Prijavljeni korisnik
User -- UC_Account
User -- UC_Schedule

' Autor
Author -- UC_SubmitPaper
Author -- UC_Return
Author -- UC_Revision
Author -- UC_Final
Author -- UC_PaperManagement

' Recenzent
Reviewer -- UC_Invitation
Reviewer -- UC_Interest
Reviewer -- UC_Discourse
Reviewer -- UC_AllReviews
Reviewer --UC_Grade


' Predsjednik programskog odbora
Chair -- UC_Setup
Chair -- UC_InviteReviewers
Chair -- UC_Assignment
Chair -- UC_Decisions
Chair -- UC_Program
Chair -- UC_Ideas
Chair -- UC_Statistics
Chair -- UC_Notify


' Administrator
Administrator -- UC_Approval
Administrator -- UC_UserManagement
Administrator -- UC_EmailManagement
Administrator -- UC_UserStatistic



' ==============================================================================
' Veze između slučajeva uporabe
' ==============================================================================

UC_SubmitPaper ..> UC_AuthorName : <<include>>

UC_Program ..> UC_ConflictProgram : <<include>>

UC_Assignment ..> UC_CheckConflict : <<include>>

UC_ReplacementReviewer ..> UC_Assignment : <<extend>>\n[recenzija kasni ili konflikt]

UC_Approval ..>UC_NameChair : <<include>>


' ==============================================================================
' Interakcije sa sekundarnim akterima (obrazac lijevo, vanjski sustav desno)
' ==============================================================================

' ORCID – registracija i prijava korisnika
UC_SignIn -- ORCID
UC_SignIn -- Mail
UC_CheckConflict -- ORCID

UC_SubmitPaper -- Crossref

' Google Calendar – izvoz osobnog rasporeda
UC_Schedule -- Calendar

' Servis e-pošte 
UC_InviteReviewers -- Mail
UC_Notify -- Mail
UC_SubmitPaper -- Mail

@enduml