<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Početna</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>
      <a href="/login" class="btn" style="padding: 6px 14px;">Prijava</a>
    </nav>
  </header>

<main>
  <section class="card">
    <h2>Dobrodošli u sustav KonfTrack</h2>
    <p>Središnji web-sustav za upravljanje znanstvenim radovima, recenzijama i konferencijskim aktivnostima.</p>
    <p>Prijavite se u sustav kako biste pristupili funkcijama namijenjenima prijavljenim korisnicima.</p>
    <a href="/login" class="btn">Prijavi se u sustav</a>
  </section>

  <section>
    <h2>Konferencije otvorene za prijavu radova</h2>

    <% if (typeof otvoreneKonferencije !== 'undefined' && otvoreneKonferencije.length > 0) { %>
      <% otvoreneKonferencije.forEach(conf => { %>
        <div class="card">
          <h3><%= conf.naziv %></h3>
          <p><%= conf.kratakOpis %></p>
          <p><strong>Mjesto i datum održavanja:</strong> <%= conf.mjesto %>, <%= new Date(conf.datumOdrzavanja).toLocaleDateString('hr-HR') %></p>
          <p><strong>Rok za prijavu radova:</strong> <%= new Date(conf.rokZaPrijavu).toLocaleDateString('hr-HR') %></p>

          <a href="/konferencije/<%= conf.id %>" class="btn">Detalji konferencije</a>
        </div>
      <% }); %>
    <% } else { %>
      <p>Trenutno nema konferencija otvorenih za prijavu radova.</p>
    <% } %>
  </section>

  <section>
    <h2>Nadolazeće konferencije</h2>

    <% if (typeof nadolazeceKonferencije !== 'undefined' && nadolazeceKonferencije.length > 0) { %>
      <% nadolazeceKonferencije.forEach(conf => { %>
        <div class="card">
          <h3><%= conf.naziv %></h3>
          <p><%= conf.kratakOpis %></p>
          <p><strong>Mjesto i datum održavanja:</strong> <%= conf.mjesto %>, <%= new Date(conf.datumOdrzavanja).toLocaleDateString('hr-HR') %></p>
          <p><strong>Rok za prijavu radova:</strong> <span style="color: crimson; font-weight: bold;">Rok za prijavu je istekao (<%= new Date(conf.rokZaPrijavu).toLocaleDateString('hr-HR') %>)</span></p>

          <a href="/konferencije/<%= conf.id %>" class="btn">Detalji konferencije</a>
        </div>
      <% }); %>
    <% } else { %>
      <p>Trenutno nema nadolazećih konferencija kojima je istekao rok za prijavu.</p>
    <% } %>
  </section>
</main>
</body>
</html>