<% 
  const isLoggedIn = true;
  const user = { username: "Ivo Ivić", uloga: "Admin" };
%>
<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Početna</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>

      <% if (isLoggedIn) { %>
        <a href="/moji-radovi">Moji radovi</a>
        <a href="/predaj-rad">Predaj rad</a>
        <a href="/moje-recenzije">Recenzije</a>
        <a href="/odluke">Odluke</a>
        <a href="/statistika">Statistika</a>
        
        <% if (user && user.uloga === 'Admin') { %>
          <a href="/admin">Admin</a>
        <% } %>

        <a href="/" style="color: crimson; font-weight: bold;">Odjava</a>
      <% } else { %>
        <a href="/login" class="btn" style="padding: 6px 14px;">Prijava</a>
      <% } %>
    </nav>
  </header>

  <main>
    <section class="card">
      <h2>Dobrodošli u sustav KonfTrack</h2>

      <% if (isLoggedIn) { %>
        <p>Prijavljeni ste kao: <strong><%= user.username %></strong> (<%= user.uloga %>)</p>
        <p>Sada su vam otključane nove mogućnosti sustava. Možete predati novi rad ili pregledati postojeće.</p>
        <a href="/predaj-rad" class="btn">Predaj novi rad</a>
      <% } else { %>
        <p>Središnji web-sustav za upravljanje znanstvenim radovima, recenzijama i konferencijskim aktivnostima.</p>
        <p>Molimo vas da se prijavite u sustav kako biste dobili pristup ostalim funkcijama i radovima.</p>
        <a href="/login" class="btn">Prijavi se u sustav</a>
      <% } %>
    </section>
  </main>
</body>
</html>