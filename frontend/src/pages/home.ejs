<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Početna</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>

    <nav>
      <a href="/">Početna</a>

      <% if (currentUser) { %>

        <!-- Navigacija dostupna prijavljenim korisnicima -->
        <a href="/moji-radovi">Moji radovi</a>
        <a href="/moje-konferencije">Moje konferencije</a>
        <a href="/moje-recenzije">Recenzije</a>

        <!-- Dodatne stranice prikazuju se samo administratoru -->
        <% if (currentUser.jeAdmin) { %>
          <a href="/admin">Admin</a>
          <a href="/statistika">Statistika</a>
        <% } %>

        <!-- Odjava se izvršava slanjem POST zahtjeva -->
        <form action="/logout" method="POST" style="display: inline;">
          <button type="submit" class="btn"
                  style="color: crimson; background: none; border: none;">
            Odjava
          </button>
        </form>

      <% } else { %>

        <!-- Gostima prikazujemo prijavu i registraciju -->
        <a href="/login" class="btn" style="padding: 6px 14px;">
          Prijava
        </a>

        <a href="/register">Registracija</a>

      <% } %>
    </nav>
  </header>

  <!-- Glavni sadržaj stranice -->
  <main>

    <section class="card">
      <h2>Dobrodošli u sustav KonfTrack</h2>

      <!-- Sadržaj za prijavljenog korisnika -->
      <% if (currentUser) { %>

        <p>
          Prijavljeni ste kao:
          <strong><%= currentUser.ime %> <%= currentUser.prezime %></strong>
        </p>

        <!-- Posebna oznaka za administratora -->
        <% if (currentUser.jeAdmin) { %>
          <p>Uloga u sustavu: Administrator</p>
        <% } %>

        <p>
          Pregledajte konferencije otvorene za prijavu znanstvenih radova.
        </p>

      <% } else { %>

        <!-- Sadržaj za goste -->
        <p>
          Središnji web-sustav za upravljanje znanstvenim radovima,
          recenzijama i konferencijskim aktivnostima.
        </p>

        <p>
          Prijavite se u sustav kako biste pristupili funkcijama
          namijenjenima prijavljenim korisnicima.
        </p>

        <a href="/login" class="btn">Prijavi se u sustav</a>

      <% } %>
    </section>

    <!-- Popis konferencija dostupnih za prijavu radova -->
    <section>
      <h2>Konferencije otvorene za prijavu radova</h2>

      <!-- Prva primjerna konferencija -->
      <div class="card">
        <h3>Međunarodna konferencija o računalnim znanostima</h3>
        <p>Rok za prijavu radova: 15.12.2026.</p>

        <!-- Prijavljeni korisnici mogu nastaviti prema predaji rada -->
        <% if (currentUser) { %>
          <a href="/predaj-rad" class="btn">Predaj rad</a>
        <% } else { %>
          <a href="/login" class="btn">Prijavi se za predaju rada</a>
        <% } %>
      </div>

      <!-- Druga primjerna konferencija -->
      <div class="card">
        <h3>Konferencija o informacijskim sustavima</h3>
        <p>Rok za prijavu radova: 20.12.2026.</p>

        <!-- Prijavljeni korisnici mogu nastaviti prema predaji rada -->
        <% if (currentUser) { %>
          <a href="/predaj-rad" class="btn">Predaj rad</a>
        <% } else { %>
          <a href="/login" class="btn">Prijavi se za predaju rada</a>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>