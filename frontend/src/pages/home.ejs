<% 
  const isLoggedIn = true;
  const user = { username: "Ivo Ivić", uloga: "Admin" };
%>
<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Početna</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>

      <% if (isLoggedIn) { %>
        <a href="/moji-radovi">Moji radovi</a>
        <a href="/moje-konferencije">Moje konferencije</a>
        <a href="/moje-recenzije">Recenzije</a>
        
        
        <% if (user && user.uloga === 'Admin') { %>
          <a href="/admin">Admin</a>
          <a href="/statistika">Statistika</a>
        <% } %>

        <a href="/" style="color: crimson; font-weight: bold;">Odjava</a>
      <% } else { %>
        <a href="/login" class="btn" style="padding: 6px 14px;">Prijava</a>
      <% } %>
    </nav>
  </header>

<main>
  <section class="card">
    <h2>Dobrodošli u sustav KonfTrack</h2>

    <% if (isLoggedIn) { %>
      <p>Prijavljeni ste kao: <strong><%= user.username %></strong> (<%= user.uloga %>)</p>
      <p>Pregledajte konferencije otvorene za prijavu znanstvenih radova.</p>
    <% } else { %>
      <p>Središnji web-sustav za upravljanje znanstvenim radovima, recenzijama i konferencijskim aktivnostima.</p>
      <p>Prijavite se u sustav kako biste pristupili funkcijama namijenjenima prijavljenim korisnicima.</p>
      <a href="/login" class="btn">Prijavi se u sustav</a>
    <% } %>
  </section>

  <section>
    <h2>Konferencije otvorene za prijavu radova</h2>

    <div class="card">
      <h3>Međunarodna konferencija o računalnim znanostima</h3>
      <p>Rok za prijavu radova: 15.12.2026.</p>

      <% if (isLoggedIn) { %>
        <a href="/predaj-rad" class="btn">Predaj rad</a>
      <% } else { %>
        <a href="/login" class="btn">Prijavi se za predaju rada</a>
      <% } %>
    </div>

    <div class="card">
      <h3>Konferencija o informacijskim sustavima</h3>
      <p>Rok za prijavu radova: 20.12.2026.</p>

      <% if (isLoggedIn) { %>
        <a href="/predaj-rad" class="btn">Predaj rad</a>
      <% } else { %>
        <a href="/login" class="btn">Prijavi se za predaju rada</a>
      <% } %>
    </div>
  </section>
</main>
</body>
</html>