<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Administrator</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>
      <a href="/statistika">Statistika</a>
    </nav>
  </header>

  <main>
    <div class="card">
      <h2>Upravljanje korisnicima i sustavom</h2>
      <table>
        <thead>
          <tr>
            <th>Korisnik</th>
            <th>E-mail</th>
            <th>Uloga</th>
            <th>Status</th>
            <th>Izmjena</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Ivo Ivić</td>
            <td>ivo@fer.hr</td>
            <td>Autor / Recenzent</td>
            <td><span class="znak aktivan">Aktivan</span></td>
            <td><button class="dng">Deaktiviraj</button></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>