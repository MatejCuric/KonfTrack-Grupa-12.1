<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Moji radovi</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>
      <a href="/predaj-rad">Predaj rad</a>
    </nav>
  </header>

  <main>
    <div class="card">
      <h2>Moji predani radovi</h2>
      <table>
        <thead>
          <tr>
            <th>Naslov rada</th>
            <th>Kategorija</th>
            <th>Status</th>
            <th>Izmjena</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Razvoj web aplikacija</td>
            <td>Znanstveni rad</td>
            <td><span class="znak u-obradi">U obradi</span></td>
            <td><a href="#" class="btn">Uredi</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>