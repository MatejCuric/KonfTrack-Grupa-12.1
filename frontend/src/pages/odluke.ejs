<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Odluke</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>
    </nav>
  </header>

  <main>
    <div class="card">
      <h2>Konačne odluke o radovima</h2>
      <table>
        <thead>
          <tr>
            <th>Naslov rada</th>
            <th>Kategorija</th>
            <th>Odluka</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Optimizacija baza podataka</td>
            <td>Znanstveni rad</td>
            <td><span class="znak" style="background-color: green; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85rem;">Prihvaćeno</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>