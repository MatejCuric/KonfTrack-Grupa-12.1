<!DOCTYPE html>
<html lang="hr">
<head>
  <script src="/js/script.js" defer></script>
  <meta charset="UTF-8">
  <title>KonfTrack - Predaja rada</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>KonfTrack</h1>
    <nav>
      <a href="/">Početna</a>
      <a href="/moji-radovi">Moji radovi</a>
    </nav>
  </header>

  <main>
    <form action="/spremi-rad" method="POST" class="card">
      <h2>Prijava novog rada</h2>
      
      <div class="form-group">
        <label for="naslov">Naslov rada:</label>
        <input type="text" id="naslov" name="naslov" required placeholder="Unesite naslov rada...">
      </div>

      <div class="form-group">
        <label for="kategorija">Kategorija:</label>
        <select id="kategorija" name="kategorija">
          <option value="znanstveni">Znanstveni rad</option>
          <option value="strucni">Stručni rad</option>
        </select>
      </div>

      <div class="form-group">
        <label for="sazetak">Sažetak:</label>
        <textarea id="sazetak" name="sazetak" placeholder="Unesite sažetak..."></textarea>
      </div>

      <button type="submit">Pošalji rad</button>
    </form>
  </main>
</body>
</html>